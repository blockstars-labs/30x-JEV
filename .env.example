# Copia este archivo como .env y completa los valores. .env no se sube al repositorio.

# live: JEV conectado (requiere la llave). mock: motor local por palabras clave, sin llave ni costo.
JEV_MODO=mock

# Llave de TypeSafe (console.typesafe.ai/keys). Necesaria con JEV_MODO=live.
TYPESAFE_API_KEY=

# Versión de JEV fijada: los umbrales de config/ se calibraron con esta versión.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# LLM (revisa las dudas de JEV, propone variables y redacta mensajes): live, mock u off.
LLM_MODO=mock

# Llave de Anthropic (console.anthropic.com). Necesaria con LLM_MODO=live.
ANTHROPIC_API_KEY=
