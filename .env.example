# Copia este archivo como .env y completa los valores. .env no se sube al repo.

# "mock" usa un JEV simulado (sin llave, sin costo). "live" llama al JEV real.
JEV_MODO=mock

# Llave de TypeSafe (console.typesafe.ai/keys). Solo necesaria en modo live.
TYPESAFE_API_KEY=

# Modelo de JEV. jev-latest apunta a la version estable.
TYPESAFE_DEFAULT_MODEL=jev-latest

# LLM para la parte "lenta" (revisar dudas de JEV y redactar mensajes): mock, live u off.
LLM_MODO=mock

# Llave de Anthropic (console.anthropic.com). Solo necesaria con LLM_MODO=live.
ANTHROPIC_API_KEY=
